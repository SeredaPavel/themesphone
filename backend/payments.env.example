# Copy secrets only to an ignored/local environment or the VPS secret env file.
# The orders foundation and payment activation are separate switches.
ORDERS_ENABLED=false
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=yookassa
YOOKASSA_MODE=test
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_RETURN_ORIGIN=http://127.0.0.1:3100
# Production: exact HTTPS storefront origins; no paths or wildcard domains.
PAYMENT_ALLOWED_ORIGINS=
# Random shared secret between Next webhook and internal Strapi; never in a URL.
PAYMENT_WEBHOOK_BRIDGE_SECRET=
# Repeat downloads: 0 = unlimited; 1..3650 = days from payment confirmation.
# Saved on order creation, so changes affect only future purchases.
ORDER_DOWNLOAD_DAYS=0
